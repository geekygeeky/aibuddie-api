    "@langchain/xai": "^1.2.2",
    "axios": "^1.13.2",
    "dodopayments": "^2.17.2",
    "elysia": "latest",
    "langchain": "^1.2.11",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "module": "src/index.js"
}